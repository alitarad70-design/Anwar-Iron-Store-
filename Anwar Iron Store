      el.addEventListener("change", function () { setQtyDirect(el.getAttribute("data-qtyinput"), el.value); });
    });
    Array.prototype.forEach.call(document.querySelectorAll("[data-removeline]"), function (el) {
      el.addEventListener("click", function () {
        state.cart = state.cart.filter(function (c) { return c.lineId !== el.getAttribute("data-removeline"); });
        render();
      });
    });

    var addCustomBtn = document.getElementById("addCustomItemBtn");
    if (addCustomBtn) addCustomBtn.addEventListener("click", function () {
      state.showCustomItemForm = true;
      state.customItemDraft = { name: "", qty: "", price: "" };
      render();
    });
    var ciName = document.getElementById("ci_name"), ciQty = document.getElementById("ci_qty"), ciPrice = document.getElementById("ci_price");
    if (ciName) ciName.addEventListener("input", function () { state.customItemDraft.name = ciName.value; });
    if (ciQty) ciQty.addEventListener("input", function () { state.customItemDraft.qty = ciQty.value; });
    if (ciPrice) ciPrice.addEventListener("input", function () { state.customItemDraft.price = ciPrice.value; });
    var saveCustomBtn = document.getElementById("saveCustomItemBtn");
    if (saveCustomBtn) saveCustomBtn.addEventListener("click", function () {
      var d = state.customItemDraft;
      var errEl = document.getElementById("customItemError");
      if (!d.name || !d.name.trim()) { errEl.textContent = "Enter an item name."; return; }
      var qtyNum = parseNum(d.qty), priceNum = parseNum(d.price);
      if (d.qty === "" || isNaN(qtyNum) || qtyNum <= 0) { errEl.textContent = "Enter a valid quantity."; return; }
      if (d.price === "" || isNaN(priceNum)) { errEl.textContent = "Enter a valid price."; return; }
      addCustomItem(d.name.trim(), qtyNum, priceNum);
      state.showCustomItemForm = false;
      state.posWarning = "";
      render();
    });
    var cancelCustomBtn = document.getElementById("cancelCustomItemBtn");
    if (cancelCustomBtn) cancelCustomBtn.addEventListener("click", function () { state.showCustomItemForm = false; render(); });

    var discountInput = document.getElementById("discountInput");
    if (discountInput) discountInput.addEventListener("input", function () {
      state.discount = discountInput.value;
      render();
      setTimeout(function () {
        var el = document.getElementById("discountInput");
        if (el) { el.focus(); el.selectionStart = el.selectionEnd = el.value.length; }
      }, 0);
    });

    var confirmBtn = document.getElementById("confirmSaleBtn");
    if (confirmBtn) confirmBtn.addEventListener("click", confirmSale);

    // Receipt
    var printBtn = document.getElementById("printBillBtn");
    if (printBtn) printBtn.addEventListener("click", function () { window.print(); });
    var waBtn = document.getElementById("whatsappBillBtn");
    if (waBtn) waBtn.addEventListener("click", function () { shareBill(state.receiptBill); });
    var newBillBtn = document.getElementById("newBillBtn");
    if (newBillBtn) newBillBtn.addEventListener("click", function () {
      state.cart = []; state.customerName = ""; state.discount = ""; state.receiptBill = null; state.posWarning = "";
      render();
    });
  }

  function addToCart(productId) {
    var p = state.products.find(function (x) { return x.id === productId; });
    if (!p) return;
    state.posWarning = "";
    var tracked = p.qty != null;
    var existing = state.cart.find(function (c) { return c.productId === productId; });
    if (existing) {
      if (tracked && existing.qty + 1 > p.qty) { state.posWarning = "Only " + p.qty + " " + p.uom + " of " + p.name + " in stock."; render(); return; }
      existing.qty += 1;
    } else {
      if (tracked && p.qty < 1) { state.posWarning = p.name + " is out of stock."; render(); return; }
      state.cart.push({ lineId: uid(), productId: p.id, name: p.name, uom: p.uom, unitRetail: p.retailPrice, unitCost: p.costPrice, qty: 1, maxQty: tracked ? p.qty : null });
    }
    state.posQuery = "";
    render();
  }
  function addCustomItem(name, qty, price) {
    state.cart.push({ lineId: uid(), productId: null, name: name, uom: "", unitRetail: price, unitCost: 0, qty: qty, maxQty: null });
  }
  function changeQty(lineId, delta) {
    state.posWarning = "";
    var c = state.cart.find(function (x) { return x.lineId === lineId; });
    if (!c) return;
    var next = Math.round((c.qty + delta) * 100) / 100;
    if (next < 0.01) return;
    if (c.maxQty != null && next > c.maxQty) { state.posWarning = "Only " + c.maxQty + " " + c.uom + " of " + c.name + " in stock."; render(); return; }
    c.qty = next; render();
  }
  function setQtyDirect(lineId, value) {
    state.posWarning = "";
    var c = state.cart.find(function (x) { return x.lineId === lineId; });
    if (!c) return;
    var v = parseNum(value);
    if (isNaN(v) || v <= 0) { render(); return; }
    if (c.maxQty != null && v > c.maxQty) { state.posWarning = "Only " + c.maxQty + " " + c.uom + " of " + c.name + " in stock."; v = c.maxQty; }
    c.qty = v; render();
  }

  function confirmSale() {
    if (!state.cart.length) { state.posWarning = "Add at least one item first."; render(); return; }
    var subtotal = state.cart.reduce(function (s, c) { return s + c.qty * c.unitRetail; }, 0);
    var discountVal = parseNum(state.discount) || 0;
    var total = Math.max(0, subtotal - discountVal);
    var billNumber = 1000 + state.bills.length + 1;
    var bill = {
      id: uid(), billNumber: billNumber, date: todayStr(), customerName: state.customerName.trim(),
      items: state.cart.map(function (c) { return { name: c.name, uom: c.uom, qty: c.qty, unitRetail: c.unitRetail, unitCost: c.unitCost }; }),
      subtotal: subtotal, discount: discountVal, total: total, updatedAt: new Date().toISOString()
    };
    state.bills.unshift(bill);
    var touchedProducts = [];
    state.cart.forEach(function (c) {
      if (!c.productId) return;
      var p = state.products.find(function (x) { return x.id === c.productId; });
      if (p && p.qty != null) {
        p.qty = Math.round((p.qty - c.qty) * 100) / 100;
        p.updatedAt = new Date().toISOString();
        touchedProducts.push(p);
      }
    });
    state.receiptBill = bill;
    persist();
    render();
    pushBill(bill);
    touchedProducts.forEach(pushProduct);
  }

  function shareBill(bill) {
    var text = billToText(bill);
    if (navigator.share) {
      navigator.share({ title: "Bill #" + bill.billNumber, text: text }).catch(function () {});
    } else {
      window.open("https://wa.me/?text=" + encodeURIComponent(text), "_blank");
    }
  }

  // First-run login state
  state.loggedIn = false;
  render();
  if (supabaseClient) {
    pullAndMerge();
    subscribeRealtime();
    setInterval(flushPendingQueue, 30000);
  }
})();
</script>
<script>
  // Structural only: enables offline caching + installable app when served over http(s).
  // No-op (and harmless) when opened directly as a local file.
  if ("serviceWorker" in navigator && (location.protocol === "https:" || location.hostname === "localhost")) {
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("service-worker.js").catch(function (err) {
        console.warn("Service worker registration failed:", err);
      });
    });
  }
</script>
