        var file = e.target.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function () {
          var rows = parseCsv(reader.result);
          var added = 0;
          var importedRecords = [];
          rows.forEach(function (r) {
            if (!r.name) return;
            var rec = {
              id: uid(), name: r.name, category: r.category || CATEGORIES[0], uom: r.uom || UOMS[0],
              costPrice: Number(r.costPrice) || 0, retailPrice: Number(r.retailPrice) || 0,
              qty: (r.qty === "" || r.qty == null) ? null : Number(r.qty),
              reorderLevel: (r.reorderLevel === "" || r.reorderLevel == null) ? null : Number(r.reorderLevel),
              supplier: r.supplier || "", updatedAt: new Date().toISOString(), deleted: false
            };
            state.products.unshift(rec);
            importedRecords.push(rec);
            added++;
          });
          persist();
          render();
          importedRecords.forEach(pushProduct);
