<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<style>
  * { box-sizing: border-box; }
  body { margin:0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background:#F3F4F6; color:#111827; }
  input, select, button { font-family: inherit; font-size:14px; }
  .header { background:#0C3B6E; color:white; padding:14px 20px; }
  .header-inner { display:flex; align-items:center; justify-content:space-between; max-width:880px; margin:0 auto; }
  .brand { display:flex; align-items:center; gap:10px; }
  .brand-name { font-size:15px; font-weight:600; }
  .logout-btn { background:none; border:none; color:#B7CBE3; cursor:pointer; font-size:12px; display:flex; align-items:center; gap:4px; }
  .container { max-width:880px; margin:0 auto; padding:0 20px 24px; }
  .nav { display:flex; gap:6px; padding:14px 0; }
  .nav button { border:none; border-radius:8px; padding:8px 14px; font-size:13px; font-weight:500; cursor:pointer; background:transparent; color:#374151; }
  .nav button.active { background:#0C3B6E; color:white; }
  .card { background:white; border-radius:10px; padding:16px; margin-bottom:14px; }
  .grid-stats { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:16px; }
  .stat { background:white; border-radius:10px; padding:12px 18px; flex:1 1 140px; }
  .stat-label { font-size:12px; color:#6B7280; }
  .stat-value { font-size:22px; font-weight:600; }
  .stat-warn { color:#B45309; }
  .btn-primary { background:#0C3B6E; color:white; border:none; border-radius:8px; padding:10px 16px; font-size:14px; font-weight:500; cursor:pointer; }
  .btn-secondary { background:white; border:1px solid #D1D5DB; border-radius:8px; padding:10px 16px; font-size:14px; font-weight:500; cursor:pointer; }
  .row { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:14px; align-items:center; }
  .search-wrap { position:relative; flex:1 1 220px; }
  .search-wrap input { width:100%; padding:8px 10px 8px 30px; border-radius:8px; border:1px solid #D1D5DB; box-sizing:border-box; }
  .search-icon { position:absolute; left:9px; top:9px; color:#9CA3AF; font-size:13px; }
  table { width:100%; border-collapse:collapse; font-size:13px; }
  thead tr { background:#F9FAFB; color:#6B7280; text-align:left; }
  th, td { padding:10px 12px; }
  tbody tr { border-top:1px solid #F0F0F0; }
  .empty-state { background:white; border-radius:10px; padding:40px 20px; text-align:center; color:#6B7280; }
  .icon-btn { border:none; background:none; cursor:pointer; padding:4px; font-size:14px; }
  .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.4); display:flex; align-items:center; justify-content:center; padding:16px; z-index:20; }
  .modal { background:white; border-radius:12px; padding:20px; width:100%; max-width:420px; max-height:90vh; overflow-y:auto; }
  .modal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
  .modal-title { font-size:16px; font-weight:600; }
  .field { margin-bottom:12px; }
  .field label { font-size:12px; color:#6B7280; display:block; margin-bottom:4px; }
  .field input, .field select { width:100%; padding:8px 10px; border-radius:8px; border:1px solid #D1D5DB; box-sizing:border-box; }
  .two-col { display:flex; gap:10px; }
  .two-col > div { flex:1; }
  .margin-box { border-radius:8px; padding:8px 12px; font-size:13px; margin-bottom:12px; }
  .margin-pos { background:#F0FDF4; color:#166534; }
  .margin-neg { background:#FEF2F2; color:#991B1B; }
  .error-text { color:#B91C1C; font-size:13px; margin-bottom:8px; }
  .save-error { background:#FEF2F2; color:#991B1B; padding:8px 12px; border-radius:8px; font-size:13px; margin-bottom:12px; }
  .login-wrap { min-height:100vh; background:#0C3B6E; display:flex; align-items:center; justify-content:center; padding:20px; }
  .login-card { background:white; border-radius:14px; padding:28px; width:100%; max-width:340px; text-align:center; }
  .login-card input { width:100%; padding:8px 10px; border-radius:8px; border:1px solid #D1D5DB; box-sizing:border-box; text-align:center; font-size:18px; letter-spacing:4px; margin-top:8px; }
  .pos-search-results { border:1px solid #E5E7EB; border-radius:8px; overflow:hidden; margin-top:8px; }
  .pos-result { display:flex; justify-content:space-between; padding:8px 10px; font-size:13px; cursor:pointer; border-bottom:1px solid #F3F4F6; }
  .pos-result:hover { background:#F9FAFB; }
  .cart-line { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; border-bottom:1px solid #F3F4F6; flex-wrap:wrap; gap:6px; }
  .qty-controls { display:flex; align-items:center; gap:6px; }
  .qty-controls button { width:26px; height:26px; border:1px solid #D1D5DB; background:white; border-radius:6px; cursor:pointer; }
  .qty-controls input { width:64px; text-align:center; padding:4px; border-radius:6px; border:1px solid #D1D5DB; }
  .warning-box { background:#FFFBEB; color:#92400E; border-radius:8px; padding:8px 12px; font-size:13px; margin-bottom:12px; }
  .totals-row { display:flex; justify-content:space-between; font-size:13px; color:#6B7280; padding:2px 0; align-items:center; }
  .totals-row input { width:90px; padding:4px 8px; border-radius:6px; border:1px solid #D1D5DB; text-align:right; font-size:13px; }
  .grand-total { display:flex; justify-content:space-between; font-size:17px; font-weight:600; border-top:1px solid #111827; margin-top:8px; padding-top:10px; color:#B45309; }
  .receipt-header { display:flex; align-items:center; gap:10px; padding-bottom:12px; border-bottom:1px solid #111827; }
  .receipt-meta { display:flex; justify-content:space-between; font-size:12px; color:#6B7280; padding-top:10px; }
  .btn-row { display:flex; gap:8px; margin-top:16px; flex-wrap:wrap; }
  .btn-row button { flex:1; min-width:100px; }
  .btn-outline { border:1px solid #D1D5DB; background:white; border-radius:8px; padding:10px; font-size:13px; cursor:pointer; }
  .btn-whatsapp { background:#25D366; color:white; border:none; border-radius:8px; padding:10px; font-size:13px; font-weight:500; cursor:pointer; }
  .low-tag { color:#B45309; }
  .hidden { display:none; }
  @media print {
    .no-print { display:none !important; }
    body { background:white; }
  }
</style>
</head>
<body>
<div id="app"></div>

<script>
(function () {
  "use strict";

  var CATEGORIES = [
    "Locks, Keys, & Door Fittings",
    "Timber and Wood",
    "Door Handles & Latches",
    "Iron Nails & Miscellaneous Screws",
    "Hinges, Chains, Bolts, Hardware",
    "Paints, Tools, & Construction Equipment",
    "White Plastic (for Roofs)",
    "Steel Jali (Wire Mesh)"
  ];
  var UOMS = ["kg", "feet", "item", "roll", "set", "packet", "piece"];
  var STORE_NAME = "Anwar Iron and Hardware Store";
  var STORE_ADDRESS = "Main Ajnala Road, Bhalwal";

  var K_PRODUCTS = "ais_products";
  var K_BILLS = "ais_bills";
  var K_PIN = "ais_pin";
  var K_PENDING = "ais_pending_sync";

  // ---------- CLOUD SYNC CONFIG ----------
  // Paste your Supabase project URL and anon (public) key below.
  // Leave as-is to run the app with local storage only (no cross-device sync).
  var SUPABASE_URL = "PASTE_YOUR_SUPABASE_URL_HERE";
  var SUPABASE_ANON_KEY = "PASTE_YOUR_SUPABASE_ANON_KEY_HERE";
  var supabaseClient = null;
  var syncConfigured = SUPABASE_URL.indexOf("PASTE_") === -1 && SUPABASE_ANON_KEY.indexOf("PASTE_") === -1;
  if (syncConfigured && window.supabase) {
    supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  }

  var state = {
    loggedIn: false,
    tab: "dashboard",
    products: load(K_PRODUCTS, []),
    bills: load(K_BILLS, []),
    pin: load(K_PIN, null),
    editingProductId: null,
    showProductForm: false,
    invQuery: "",
    posQuery: "",
    cart: [],
    customerName: "",
    discount: "",
    posWarning: "",
    receiptBill: null,
    showCustomItemForm: false,
    customItemDraft: { name: "", qty: "", price: "" },
    syncStatus: !syncConfigured ? "off" : (navigator.onLine ? "syncing" : "offline")
  };

  function load(key, fallback) {
    try {
      var v = localStorage.getItem(key);
      return v ? JSON.parse(v) : fallback;
    } catch (e) { return fallback; }
  }
  function persist() {
    try {
      localStorage.setItem(K_PRODUCTS, JSON.stringify(state.products));
      localStorage.setItem(K_BILLS, JSON.stringify(state.bills));
      if (state.pin) localStorage.setItem(K_PIN, JSON.stringify(state.pin));
    } catch (e) {
      console.error("Storage error", e);
    }
  }

  // ---------- CLOUD SYNC ENGINE ----------
  // Everything below is additive: if Supabase isn't configured, or the device
  // is offline, the app behaves exactly as the local-only version did.
  function getPendingQueue() { return load(K_PENDING, []); }
  function setPendingQueue(q) { try { localStorage.setItem(K_PENDING, JSON.stringify(q)); } catch (e) {} }
  function queuePending(kind, id) {
    var q = getPendingQueue();
    if (!q.some(function (x) { return x.kind === kind && x.id === id; })) {
      q.push({ kind: kind, id: id });
      setPendingQueue(q);
    }
  }
  function clearPending(kind, id) {
    setPendingQueue(getPendingQueue().filter(function (x) { return !(x.kind === kind && x.id === id); }));
  }

  function productToRow(p) {
    return {
      id: p.id, name: p.name, category: p.category, uom: p.uom,
      cost_price: p.costPrice, retail_price: p.retailPrice,
      qty: p.qty, reorder_level: p.reorderLevel, supplier: p.supplier,
      updated_at: p.updatedAt || new Date().toISOString(), deleted: !!p.deleted
    };
  }
  function rowToProduct(r) {
    return {
      id: r.id, name: r.name, category: r.category, uom: r.uom,
      costPrice: Number(r.cost_price) || 0, retailPrice: Number(r.retail_price) || 0,
      qty: r.qty == null ? null : Number(r.qty), reorderLevel: r.reorder_level == null ? null : Number(r.reorder_level),
      supplier: r.supplier || "", updatedAt: r.updated_at, deleted: !!r.deleted
    };
  }
  function billToRow(b) {
    return {
      id: b.id, bill_number: b.billNumber, date: b.date, customer_name: b.customerName,
      items: b.items, subtotal: b.subtotal, discount: b.discount, total: b.total,
      updated_at: b.updatedAt || new Date().toISOString()
    };
  }
  function rowToBill(r) {
    return {
      id: r.id, billNumber: r.bill_number, date: r.date, customerName: r.customer_name || "",
      items: r.items || [], subtotal: Number(r.subtotal) || 0, discount: Number(r.discount) || 0,
      total: Number(r.total) || 0, updatedAt: r.updated_at
    };
  }

  function setSyncStatus(s) { state.syncStatus = s; renderSyncBadge(); }

  function pushProduct(p) {
    if (!supabaseClient) return;
    setSyncStatus("syncing");
    supabaseClient.from("products").upsert(productToRow(p)).then(function (res) {
      if (res.error) { queuePending("product", p.id); setSyncStatus("offline"); }
      else { clearPending("product", p.id); setSyncStatus("synced"); }
    }).catch(function () { queuePending("product", p.id); setSyncStatus("offline"); });
  }
  function pushBill(b) {
    if (!supabaseClient) return;
    setSyncStatus("syncing");
    supabaseClient.from("bills").upsert(billToRow(b)).then(function (res) {
      if (res.error) { queuePending("bill", b.id); setSyncStatus("offline"); }
      else { clearPending("bill", b.id); setSyncStatus("synced"); }
    }).catch(function () { queuePending("bill", b.id); setSyncStatus("offline"); });
  }

  function flushPendingQueue() {
    if (!supabaseClient || !navigator.onLine) return;
    var q = getPendingQueue();
    q.forEach(function (item) {
      if (item.kind === "product") {
        var p = state.products.find(function (x) { return x.id === item.id; });
        if (p) pushProduct(p); else clearPending("product", item.id);
      } else if (item.kind === "bill") {
        var b = state.bills.find(function (x) { return x.id === item.id; });
        if (b) pushBill(b); else clearPending("bill", item.id);
      }
    });
  }

  function mergeByUpdatedAt(localList, remoteList, keyFn) {
    var map = {};
    localList.forEach(function (item) { map[item.id] = item; });
    remoteList.forEach(function (remote) {
      var local = map[remote.id];
      if (!local || !local.updatedAt || (remote.updatedAt && remote.updatedAt > local.updatedAt)) {
        map[remote.id] = remote;
      }
    });
    return Object.keys(map).map(function (k) { return map[k]; });
  }

  function pullAndMerge() {
    if (!supabaseClient) return;
    setSyncStatus("syncing");
    Promise.all([
      supabaseClient.from("products").select("*"),
      supabaseClient.from("bills").select("*")
    ]).then(function (results) {
      var prodRes = results[0], billRes = results[1];
      if (!prodRes.error && prodRes.data) {
        var remoteProducts = prodRes.data.map(rowToProduct).filter(function (p) { return !p.deleted; });
        state.products = mergeByUpdatedAt(state.products, remoteProducts);
      }
      if (!billRes.error && billRes.data) {
        var remoteBills = billRes.data.map(rowToBill);
        state.bills = mergeByUpdatedAt(state.bills, remoteBills);
        state.bills.sort(function (a, b) { return (b.billNumber || 0) - (a.billNumber || 0); });
      }
      persist();
      setSyncStatus("synced");
      if (state.loggedIn) render();
    }).catch(function () { setSyncStatus("offline"); });
  }

  function subscribeRealtime() {
    if (!supabaseClient) return;
    supabaseClient.channel("products-changes")
      .on("postgres_changes", { event: "*", schema: "public", table: "products" }, function (payload) {
        if (payload.eventType === "DELETE") return;
        var incoming = rowToProduct(payload.new);
        if (incoming.deleted) {
          state.products = state.products.filter(function (p) { return p.id !== incoming.id; });
        } else {
          state.products = mergeByUpdatedAt(state.products, [incoming]);
        }
        persist();
        if (state.loggedIn) render();
      }).subscribe();
    supabaseClient.channel("bills-changes")
      .on("postgres_changes", { event: "*", schema: "public", table: "bills" }, function (payload) {
        if (payload.eventType === "DELETE") return;
        var incoming = rowToBill(payload.new);
        state.bills = mergeByUpdatedAt(state.bills, [incoming]);
        state.bills.sort(function (a, b) { return (b.billNumber || 0) - (a.billNumber || 0); });
        persist();
        if (state.loggedIn) render();
      }).subscribe();
  }

  function renderSyncBadge() {
    var el = document.getElementById("syncBadge");
    if (!el) return;
    var map = {
      off: ["#9CA3AF", "Cloud sync not set up"],
      offline: ["#D97706", "Offline \u2014 saving locally"],
      syncing: ["#D97706", "Syncing\u2026"],
      synced: ["#22C55E", "Synced"]
    };
    var v = map[state.syncStatus] || map.off;
    el.innerHTML = '<span style="width:7px;height:7px;border-radius:50%;background:' + v[0] + ';display:inline-block;"></span>' + v[1];
  }

  window.addEventListener("online", function () { setSyncStatus("syncing"); flushPendingQueue(); pullAndMerge(); });
  window.addEventListener("offline", function () { setSyncStatus("offline"); });
  function currency(n) {
    var v = Number(n) || 0;
    return "Rs " + v.toLocaleString("en-PK", { maximumFractionDigits: 2 });
  }
  function parseNum(v) {
    if (v == null) return NaN;
    var cleaned = String(v).replace(/,/g, "").trim();
    if (cleaned === "") return NaN;
    return Number(cleaned);
  }
  function todayStr() {
    var d = new Date();
    return d.toISOString().slice(0, 10);
  }
  function todayDisplay() {
    return new Date().toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
  }
  function uid() {
    return Date.now() + "-" + Math.random().toString(36).slice(2);
  }
  function esc(s) {
    var d = document.createElement("div");
    d.textContent = s == null ? "" : String(s);
    return d.innerHTML;
  }
  function unitLabel(uom) {
    var map = { kg: "per kg", feet: "per ft", item: "per item", roll: "per roll", set: "per set", packet: "per packet", piece: "per piece" };
    return map[uom] || "per unit";
  }

  var app = document.getElementById("app");

  function render() {
    if (!state.loggedIn) { renderLogin(); return; }
    var html = "";
    html += '<div class="header no-print"><div class="header-inner">';
    html += '<div class="brand">' + logoSvg(28) + '<div class="brand-name">' + esc(STORE_NAME) + '</div></div>';
    html += '<div style="display:flex;align-items:center;gap:14px;">';
    html += '<span id="syncBadge" style="display:flex;align-items:center;gap:5px;font-size:11px;color:#B7CBE3;"></span>';
    html += '<button class="logout-btn" id="logoutBtn">Log out</button>';
    html += '</div>';
    html += '</div></div>';
    html += '<div class="container">';
    html += '<div class="nav no-print">';
    html += navBtn("dashboard", "Dashboard");
    html += navBtn("inventory", "Inventory");
    html += navBtn("pos", "New bill");
    html += '</div>';
    if (state.saveError) html += '<div class="save-error">' + esc(state.saveError) + '</div>';
    if (state.tab === "dashboard") html += renderDashboard();
    if (state.tab === "inventory") html += renderInventory();
    if (state.tab === "pos") html += renderPOS();
    html += '</div>';
    if (state.showProductForm) html += renderProductForm();
    if (state.receiptBill) html += renderReceipt(state.receiptBill);
    app.innerHTML = html;
    attachHandlers();
    renderSyncBadge();
  }

  function navBtn(key, label) {
    return '<button data-tab="' + key + '" class="' + (state.tab === key ? "active" : "") + '">' + label + '</button>';
  }

  function logoSvg(size) {
    return '<svg width="' + size + '" height="' + size + '" viewBox="0 0 40 40" aria-hidden="true">' +
      '<path d="M4 22L20 8L36 22" fill="none" stroke="#D8AA3E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>' +
      '<circle cx="27" cy="14" r="7" fill="none" stroke="#D8AA3E" stroke-width="2"/>' +
      '<circle cx="27" cy="14" r="2" fill="#D8AA3E"/></svg>';
  }

  // ---------- LOGIN ----------
  function renderLogin() {
    var settingUp = !state.pin;
    var html = '<div class="login-wrap"><div class="login-card">';
    html += logoSvg(40);
    html += '<div style="font-size:16px;font-weight:600;margin-top:10px;">' + esc(STORE_NAME) + '</div>';
    html += '<div style="font-size:13px;color:#6B7280;margin-bottom:18px;">' + (settingUp ? "Set an admin PIN to protect this app" : "Enter your admin PIN") + '</div>';
    html += '<input type="password" inputmode="numeric" id="pinInput" placeholder="PIN">';
    if (settingUp) html += '<input type="password" inputmode="numeric" id="pinConfirm" placeholder="Confirm PIN">';
    html += '<div class="error-text" id="loginError" style="margin-top:8px;"></div>';
    html += '<button class="btn-primary" style="width:100%;margin-top:6px;" id="loginSubmit">' + (settingUp ? "Set PIN and continue" : "Log in") + '</button>';
    html += '</div></div>';
    app.innerHTML = html;

    document.getElementById("loginSubmit").addEventListener("click", function () {
      var val = document.getElementById("pinInput").value;
      var errEl = document.getElementById("loginError");
      if (settingUp) {
        var confirmVal = document.getElementById("pinConfirm").value;
        if (val.length < 4) { errEl.textContent = "PIN must be at least 4 digits."; return; }
        if (val !== confirmVal) { errEl.textContent = "PINs don't match."; return; }
        state.pin = val;
        persist();
        state.loggedIn = true;
        render();
      } else {
        if (val !== state.pin) { errEl.textContent = "Incorrect PIN."; return; }
        state.loggedIn = true;
        render();
      }
    });
  }

  // ---------- DASHBOARD ----------
  function renderDashboard() {
    var today = todayStr();
    var todaysBills = state.bills.filter(function (b) { return b.date === today; });
    var todaysSales = todaysBills.reduce(function (s, b) { return s + b.total; }, 0);
    var todaysProfit = todaysBills.reduce(function (s, b) {
      return s + b.items.reduce(function (si, it) { return si + (it.unitRetail - it.unitCost) * it.qty; }, 0);
    }, 0);
    var lowStock = state.products.filter(function (p) { return p.qty != null && p.reorderLevel != null && p.qty <= p.reorderLevel; });

    var html = '<div class="grid-stats">';
    html += '<div class="stat"><div class="stat-label">Today\'s sales</div><div class="stat-value">' + currency(todaysSales) + '</div></div>';
    html += '<div class="stat"><div class="stat-label">Today\'s profit</div><div class="stat-value">' + currency(todaysProfit) + '</div></div>';
    html += '<div class="stat"><div class="stat-label">Low stock</div><div class="stat-value ' + (lowStock.length ? "stat-warn" : "") + '">' + lowStock.length + '</div></div>';
    html += '</div>';

    html += '<div class="row"><button class="btn-primary" style="flex:1;" data-tab="pos">New bill</button><button class="btn-secondary" style="flex:1;" data-tab="inventory">Inventory</button></div>';

    if (lowStock.length) {
      html += '<div class="card"><div style="font-size:14px;font-weight:600;margin-bottom:8px;">Low stock alerts</div>';
